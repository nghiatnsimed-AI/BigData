# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtual environments (650+ MB) — recreate with: python -m venv .venv311
.venv311/
.venv/
venv/
env/

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
Desktop.ini

# --- Spark / Hadoop local junk ---
metastore_db/
derby.log
spark-warehouse/
checkpoint/
*.crc

# --- Heavy pipeline data (rebuild locally; GitHub limit 100 MB/file) ---
# Raw CSVs ~14 GB, Bronze ~4.5 GB, Silver ~4.1 GB, Gold Parquet ~20 MB
E-commerce/Data/raw/*
!E-commerce/Data/raw/.gitkeep
E-commerce/Data/bronze/*
!E-commerce/Data/bronze/.gitkeep
E-commerce/Data/silver/*
!E-commerce/Data/silver/.gitkeep
E-commerce/Data/gold/*
!E-commerce/Data/gold/.gitkeep

# Extra safety: never commit Parquet partitions even if they appear elsewhere
*.parquet
*.snappy.parquet

# Row-level dashboard dumps (too large for Git, regenerated by Data_Dashboard.py)
E-commerce/Data/dashboard/kpi_user_segment.csv
E-commerce/Data/dashboard/kpi_product_ranking.csv
